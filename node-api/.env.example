PORT=4000
NODE_ENV=development

DATABASE_URL=postgresql://saas_user:saas_password@localhost:5432/ai_support_saas
REDIS_URL=redis://localhost:6379/0
PYTHON_API_URL=http://localhost:8000

# Production Reliability workstream (see docs/RELIABILITY.md). Defaults
# shown are also the built-in fallback if unset — safe for local dev.
# Tune DB_POOL_MAX alongside Postgres's own max_connections as you add
# node-api replicas; see docs/RELIABILITY.md "Scaling triggers".
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=15000

# Knowledge Base document storage (CUSTOMER-KNOWLEDGE-RAG-API-001).
UPLOADS_DIR=/app/uploads
MAX_UPLOAD_SIZE_BYTES=20971520

JWT_SECRET=change-me-in-production

# Shared secret sent as x-internal-secret to python-api on every call —
# must match INTERNAL_SERVICE_SECRET in python-api/.env exactly.
INTERNAL_SERVICE_SECRET=change-me-to-a-long-random-string

# WhatsApp Cloud API — ONE Meta App serves every tenant (per-tenant
# phone number + access token live in the channel_credentials table
# instead, connected via POST /channels/whatsapp/credentials).
# WHATSAPP_VERIFY_TOKEN: any string you choose; enter the SAME value
#   when configuring the webhook URL in the Meta App dashboard.
# WHATSAPP_APP_SECRET: from the Meta App dashboard (App Settings > Basic).
WHATSAPP_VERIFY_TOKEN=choose-a-verify-token
WHATSAPP_APP_SECRET=your-meta-app-secret-here
WHATSAPP_GRAPH_API_BASE_URL=https://graph.facebook.com/v21.0

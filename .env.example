# Copy this file to .env and fill in real values.
# docker-compose reads these for the postgres service.

POSTGRES_USER=saas_user
POSTGRES_PASSWORD=saas_password
POSTGRES_DB=ai_support_saas

# Shared secret between node-api and python-api (see docs/API_CONTRACTS.md).
# docker-compose passes this SAME value to both services, overriding
# whatever is set in node-api/.env or python-api/.env individually when
# running via `docker compose up`. Only matters as two separate values
# if you run either service outside Docker.
INTERNAL_SERVICE_SECRET=change-me-to-a-long-random-string

# Production Reliability workstream (ops/backup/, docs/RELIABILITY.md).
# Defaults shown are also the built-in fallback if unset -- local-only,
# daily backups is fine for dev. Set BACKUP_S3_BUCKET (+ credentials)
# for production; a backup on the same disk as the primary does not
# survive disk/server failure.
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=7
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

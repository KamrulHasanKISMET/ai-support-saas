DATABASE_URL=postgresql+asyncpg://saas_user:saas_password@localhost:5432/ai_support_saas
REDIS_URL=redis://localhost:6379/0

# LLM provider
ANTHROPIC_API_KEY=your-api-key-here
LLM_MODEL=claude-sonnet-5

# Embedding model — swap freely, table dimension (1536) must match
EMBEDDING_MODEL=text-embedding-3-small
OPENAI_API_KEY=your-openai-api-key-here

# Kernel thresholds (defaults; overridden per-tenant via agent_configs)
INTENT_CONFIDENCE_MIN=0.60

# Shared secret node-api must present on every call to this service —
# must match INTERNAL_SERVICE_SECRET in node-api/.env exactly.
INTERNAL_SERVICE_SECRET=change-me-to-a-long-random-string

# Production Reliability workstream (see docs/RELIABILITY.md). Defaults
# shown are also the built-in fallback if unset. Keep
# (DB_POOL_SIZE + DB_MAX_OVERFLOW) for this service, PLUS node-api's
# DB_POOL_MAX, under Postgres's own max_connections — see
# docs/RELIABILITY.md "Scaling triggers".
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
